APP_NAME="ATLAS VOC Analysis"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=info

# Database (PostgreSQL on Railway / SQLite for local testing)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=railway
DB_USERNAME=postgres
DB_PASSWORD=

# Session, Cache & Database Queues
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# AI Gateway Integration (Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
